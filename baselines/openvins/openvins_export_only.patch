+size_t diagnostic_observation_count(const Feature &feature) {
+  size_t count = 0;
+  for (const auto &item : feature.timestamps)
+    count += item.second.size();
+  return count;
+}
+
+void diagnostic_time_range(const Feature &feature, double &first, double &last) {
+  first = std::numeric_limits<double>::infinity();
+  last = -std::numeric_limits<double>::infinity();
+  for (const auto &item : feature.timestamps) {
+    for (double timestamp : item.second) {
+      first = std::min(first, timestamp);
+      last = std::max(last, timestamp);
+    }
+  }
+}
+
+void compute_export_diagnostics(
+    const std::shared_ptr<State> &state, const std::shared_ptr<Feature> &feature,
+    std::unordered_map<size_t, std::unordered_map<double, FeatureInitializer::ClonePose>> &clones_cam,
+    MsckfFeatureDiagnostic &diagnostic) {
+  diagnostic.position_global = feature->p_FinG;
+  diagnostic.triangulation_success = feature->p_FinG.allFinite();
+  if (!diagnostic.triangulation_success)
+    return;
+
+  Eigen::Matrix3d bearing_normal_matrix = Eigen::Matrix3d::Zero();
+  std::vector<double> reprojection_errors;
+  for (const auto &camera_item : feature->timestamps) {
+    const size_t camera_id = camera_item.first;
+    for (size_t index = 0; index < camera_item.second.size(); ++index) {
+      auto &clone = clones_cam.at(camera_id).at(camera_item.second.at(index));
+      const Eigen::Vector3d point_camera = clone.Rot() * (feature->p_FinG - clone.pos());
+      ++diagnostic.depth_check_count;
+      if (point_camera(2) > 0)
+        ++diagnostic.positive_depth_count;
+      if (std::abs(point_camera(2)) > 1e-12) {
+        const Eigen::Vector2d normalized = point_camera.head<2>() / point_camera(2);
+        const Eigen::Vector2d predicted = state->_cam_intrinsics_cameras.at(camera_id)->distort_d(normalized);
+        reprojection_errors.push_back((predicted - feature->uvs.at(camera_id).at(index).cast<double>()).norm());
+      }
+      Eigen::Vector3d bearing(feature->uvs_norm.at(camera_id).at(index)(0),
+                              feature->uvs_norm.at(camera_id).at(index)(1), 1.0);
+      bearing = clone.Rot().transpose() * bearing.normalized();
+      const Eigen::Matrix3d projector = Eigen::Matrix3d::Identity() - bearing * bearing.transpose();
+      bearing_normal_matrix += projector;
+    }
+  }
+  const Eigen::Vector3d singular = Eigen::JacobiSVD<Eigen::Matrix3d>(bearing_normal_matrix).singularValues();
+  diagnostic.triangulation_condition =
+      singular(2) > std::numeric_limits<double>::epsilon() ? singular(0) / singular(2)
+                                                          : std::numeric_limits<double>::infinity();
+  if (!reprojection_errors.empty()) {
+    std::sort(reprojection_errors.begin(), reprojection_errors.end());
+    diagnostic.reprojection_mean_px =
+        std::accumulate(reprojection_errors.begin(), reprojection_errors.end(), 0.0) / reprojection_errors.size();
+    diagnostic.reprojection_median_px = reprojection_errors[reprojection_errors.size() / 2];
+    const size_t p95_index =
+        std::min(reprojection_errors.size() - 1, static_cast<size_t>(std::ceil(0.95 * reprojection_errors.size()) - 1));
+    diagnostic.reprojection_p95_px = reprojection_errors[p95_index];
+  }
+}
